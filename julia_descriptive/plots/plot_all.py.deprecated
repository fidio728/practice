"""
plot_all.py
Generate publication-quality figures from CSVs produced by the Julia scripts.

Reads:   julia_descriptive/output/*.csv
Writes:  julia_descriptive/plots/figures/*.png

Run from inside julia_descriptive/plots/:
    python plot_all.py

Or specify a figure:
    python plot_all.py fig1
"""

from __future__ import annotations

import os
import sys
import warnings
from pathlib import Path

import matplotlib.dates as mdates
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import seaborn as sns

# ============================================================
# Paths and style
# ============================================================
HERE       = Path(__file__).parent
OUTPUT_DIR = HERE.parent / "output"
FIG_DIR    = HERE / "figures"
FIG_DIR.mkdir(exist_ok=True)

# Publication style
plt.rcParams.update({
    "font.family":        "serif",
    "font.size":          11,
    "axes.titlesize":     12,
    "axes.labelsize":     11,
    "xtick.labelsize":    10,
    "ytick.labelsize":    10,
    "legend.fontsize":    10,
    "figure.titlesize":   13,
    "axes.spines.top":    False,
    "axes.spines.right":  False,
    "savefig.bbox":       "tight",
    "savefig.dpi":        150,
})
sns.set_palette("colorblind")

PALETTE = sns.color_palette("colorblind")
COLOR_US        = PALETTE[3]   # red
COLOR_NONUS     = PALETTE[0]   # blue
COLOR_GPR       = PALETTE[2]   # green
COLOR_NEUTRAL   = "#666666"
EXP_GROUP_COLORS = {
    "ZERO": "#888888",
    "LOW":  PALETTE[0],
    "MID":  PALETTE[1],
    "HIGH": PALETTE[3],
}


# ============================================================
# Helpers
# ============================================================
def _safe_read(filename: str) -> pd.DataFrame | None:
    """Read a CSV from OUTPUT_DIR; return None if missing."""
    fp = OUTPUT_DIR / filename
    if not fp.exists():
        warnings.warn(f"missing: {fp.name}")
        return None
    df = pd.read_csv(fp)
    # Parse common date columns
    for c in ("month_end", "report_date", "month_first"):
        if c in df.columns:
            df[c] = pd.to_datetime(df[c])
    return df


def _date_axis(ax: plt.Axes, span_years: float) -> None:
    """Tidy date axis with rotation."""
    if span_years > 8:
        ax.xaxis.set_major_locator(mdates.YearLocator(2))
        ax.xaxis.set_major_formatter(mdates.DateFormatter("%Y"))
    else:
        ax.xaxis.set_major_locator(mdates.YearLocator(1))
        ax.xaxis.set_major_formatter(mdates.DateFormatter("%Y"))
    for label in ax.get_xticklabels():
        label.set_rotation(0)


def _save(fig: plt.Figure, name: str) -> None:
    out = FIG_DIR / f"{name}.png"
    fig.savefig(out)
    plt.close(fig)
    print(f"  -> {out.relative_to(HERE.parent)}")


def _span_years(dates: pd.Series) -> float:
    if dates.empty:
        return 0.0
    return (dates.max() - dates.min()).days / 365.25


# ============================================================
# FIG 1: China-exposure overview (2x2 grid)
# ============================================================
def fig1_china_exposure_overview() -> None:
    """
    Quadrants:
      (TL) # EU firms with any CN relation over time
      (TR) Avg # CN relations per exposed firm
      (BL) Distribution of n_cn_total at snapshot
      (BR) Breakdown by relation type over time
    """
    ts   = _safe_read("02_china_exposure_timeseries.csv")
    dist = _safe_read("02_dist_cn_total_2018.csv")
    if ts is None:
        return

    fig, axes = plt.subplots(2, 2, figsize=(12, 8), constrained_layout=True)

    # TL — extensive margin
    ax = axes[0, 0]
    ax.plot(ts["month_end"], ts["n_firms_with_cn"], color=PALETTE[0], lw=1.5)
    ax.set_title("(a) Extensive margin: # EU firms with CN supply-chain link")
    ax.set_xlabel("")
    ax.set_ylabel("# firms")
    _date_axis(ax, _span_years(ts["month_end"]))

    # TR — intensive margin
    ax = axes[0, 1]
    ax.plot(ts["month_end"], ts["avg_cn_rels"], color=PALETTE[3], lw=1.5)
    ax.set_title("(b) Intensive margin: avg # CN relations per exposed firm")
    ax.set_xlabel("")
    ax.set_ylabel("mean count")
    _date_axis(ax, _span_years(ts["month_end"]))

    # BL — distribution at snapshot
    ax = axes[1, 0]
    if dist is not None and not dist.empty:
        # dist has columns (n_cn_total, n_firms) — long format with count per bucket
        ax.bar(dist["n_cn_total"], dist["n_firms"],
               width=0.9, color=PALETTE[0], alpha=0.75, edgecolor="white")
        ax.set_xlim(0, min(40, dist["n_cn_total"].max() + 2))
        ax.set_title("(c) Distribution of # CN relations per exposed firm (2018-12-31)")
        ax.set_xlabel("# CN relations")
        ax.set_ylabel("# firms")
    else:
        ax.text(0.5, 0.5, "snapshot CSV not found", ha="center", transform=ax.transAxes)
        ax.axis("off")

    # BR — breakdown by relation type
    ax = axes[1, 1]
    rel_cols = [(c, c.replace("avg_cn_", "").upper())
                for c in ("avg_cn_customer", "avg_cn_supplier", "avg_cn_jv")
                if c in ts.columns]
    for (col, label), color in zip(rel_cols, [PALETTE[0], PALETTE[1], PALETTE[3]]):
        ax.plot(ts["month_end"], ts[col], label=label, lw=1.5, color=color)
    if "avg_cn_rels" in ts.columns:
        ax.plot(ts["month_end"], ts["avg_cn_rels"], label="TOTAL",
                lw=2, color="black", linestyle="--", alpha=0.6)
    ax.set_title("(d) Relation type composition over time")
    ax.set_xlabel("")
    ax.set_ylabel("avg # per exposed firm")
    ax.legend(loc="upper left", frameon=False)
    _date_axis(ax, _span_years(ts["month_end"]))

    fig.suptitle("China supply-chain exposure of European firms (Revere)",
                 fontweight="bold")
    _save(fig, "fig1_cn_exposure_overview")


# ============================================================
# FIG 2: US-EU engagement (2-panel vertical)
# ============================================================
def fig2_us_eu_engagement() -> None:
    df = _safe_read("03_us_x_eu_cells_by_month.csv")
    if df is None:
        return

    fig, axes = plt.subplots(2, 1, figsize=(11, 7), sharex=True,
                             constrained_layout=True)

    # Top: counts (dual axis)
    ax1 = axes[0]
    ax1.plot(df["report_date"], df["n_us_funds"],
             label="# US funds holding EU firms",
             color=COLOR_US, lw=1.8)
    ax1.set_ylabel("# US funds", color=COLOR_US)
    ax1.tick_params(axis="y", labelcolor=COLOR_US)

    ax1b = ax1.twinx()
    ax1b.plot(df["report_date"], df["n_eu_firms"],
              label="# EU firms held by US funds",
              color=COLOR_NONUS, lw=1.8, linestyle="--")
    ax1b.set_ylabel("# EU firms", color=COLOR_NONUS)
    ax1b.tick_params(axis="y", labelcolor=COLOR_NONUS)
    ax1b.spines["right"].set_visible(True)

    # Combined legend
    lines1, labels1 = ax1.get_legend_handles_labels()
    lines2, labels2 = ax1b.get_legend_handles_labels()
    ax1.legend(lines1 + lines2, labels1 + labels2,
               loc="lower right", frameon=False)
    ax1.set_title("(a) US-EU engagement: investor and firm counts")
    _date_axis(ax1, _span_years(df["report_date"]))

    # Bottom: total US-held value
    ax2 = axes[1]
    ax2.plot(df["report_date"], df["total_mv_b"],
             color=PALETTE[2], lw=1.8)
    ax2.set_title("(b) Total US-held EU equity (USD billions)")
    ax2.set_xlabel("")
    ax2.set_ylabel("USD billions")
    _date_axis(ax2, _span_years(df["report_date"]))

    fig.suptitle("US institutional engagement in European equities",
                 fontweight="bold")
    _save(fig, "fig2_us_eu_engagement")


# ============================================================
# FIG 3: US-ownership distribution + by-country (2x2 grid)
# ============================================================
def fig3_us_ownership_distribution() -> None:
    snap   = _safe_read("04_us_ownership_eu_snapshot.csv")
    bycn   = _safe_read("04_us_own_by_eu_country_snapshot.csv")
    ts     = _safe_read("04_us_ownership_eu_timeseries.csv")
    if snap is None and bycn is None and ts is None:
        return

    fig, axes = plt.subplots(2, 2, figsize=(13, 8.5), constrained_layout=True)

    # TL — distribution of ownership share at snapshot
    ax = axes[0, 0]
    if snap is not None and not snap.empty:
        x = snap["ownership_share"].dropna() * 100
        ax.hist(x, bins=40, color=PALETTE[0], alpha=0.75, edgecolor="white")
        for p, label, color in [(50, "P50", "black"),
                                 (75, "P75", "gray"),
                                 (90, "P90", "darkred")]:
            v = np.percentile(x, p)
            ax.axvline(v, color=color, linestyle="--", lw=1, alpha=0.7)
            ax.text(v, ax.get_ylim()[1] * 0.92, f" {label}={v:.1f}%",
                    color=color, fontsize=9, va="top")
        ax.set_title("(a) Distribution of US ownership share, EU firms (snapshot)")
        ax.set_xlabel("US ownership share (%)")
        ax.set_ylabel("# firms")
        ax.set_xlim(0, min(40, x.quantile(0.99) * 1.1))

    # TR — mean US ownership over time
    ax = axes[0, 1]
    if ts is not None and not ts.empty:
        ax.plot(ts["report_date"], ts["mean_us_own"] * 100,
                color=COLOR_US, lw=1.8)
        ax.set_title("(b) Mean US ownership of EU firms over time")
        ax.set_xlabel("")
        ax.set_ylabel("mean ownership (%)")
        _date_axis(ax, _span_years(ts["report_date"]))

    # BL — total US-held EU equity over time
    ax = axes[1, 0]
    if ts is not None and "total_us_holding_b" in ts.columns:
        ax.plot(ts["report_date"], ts["total_us_holding_b"],
                color=PALETTE[2], lw=1.8)
        ax.set_title("(c) Total US-held EU equity over time (USD B)")
        ax.set_xlabel("")
        ax.set_ylabel("USD billions")
        _date_axis(ax, _span_years(ts["report_date"]))

    # BR — by EU country (horizontal bar)
    ax = axes[1, 1]
    if bycn is not None and not bycn.empty:
        top = bycn.sort_values("total_us_holding_b", ascending=True).tail(15)
        ax.barh(top["sec_country"], top["total_us_holding_b"],
                color=PALETTE[0], alpha=0.85, edgecolor="white")
        ax.set_title("(d) Total US-held EU equity by country (USD B, top 15)")
        ax.set_xlabel("USD billions")
        ax.set_ylabel("")
        for i, (country, val) in enumerate(zip(top["sec_country"],
                                                top["total_us_holding_b"])):
            ax.text(val, i, f" {val:.0f}", va="center", fontsize=9)

    fig.suptitle("US institutional ownership of European firms",
                 fontweight="bold")
    _save(fig, "fig3_us_ownership_distribution")


# ============================================================
# FIG 4: Pre-regression visualisations (2x2 grid)
# ============================================================
def fig4_pre_regression() -> None:
    sc = _safe_read("05_scatter_own_vs_cn_data.csv")
    ts = _safe_read("05_within_europe_share_by_group.csv")
    cmp = _safe_read("05_us_vs_nonus_high_share_data.csv")
    diff = _safe_read("05_diff_us_vs_nonus_high.csv")

    fig, axes = plt.subplots(2, 2, figsize=(13, 9), constrained_layout=True)

    # TL — scatter ownership vs CN exposure
    ax = axes[0, 0]
    if sc is not None and not sc.empty:
        x = np.log1p(sc["n_cn_total"])
        y = sc["us_ownership_share"] * 100
        ax.scatter(x, y, alpha=0.35, s=12, color=PALETTE[0], edgecolors="none")
        if len(x) > 5 and x.std() > 0:
            m, b = np.polyfit(x, y, 1)
            xs = np.linspace(x.min(), x.max(), 100)
            ax.plot(xs, m * xs + b, color="black", lw=1.2, linestyle="--",
                    label=f"slope={m:.2f}")
            ax.legend(loc="upper right", frameon=False)
        ax.set_title("(A) US ownership vs CN exposure (matched-Revere EU firms)")
        ax.set_xlabel("log(1 + # CN supply-chain relations)")
        ax.set_ylabel("US ownership (%)")

    # TR — within-Europe share by exposure group (US only)
    ax = axes[0, 1]
    if ts is not None and not ts.empty:
        us = ts[ts["investor_country"] == "US"].copy()
        for grp in ["ZERO", "LOW", "MID", "HIGH"]:
            sub = us[us["exp_grp"] == grp]
            if sub.empty:
                continue
            ax.plot(sub["report_date"], sub["within_europe_share"] * 100,
                    label=grp, lw=1.8, color=EXP_GROUP_COLORS[grp])
        ax.set_title("(B) US allocation by China-exposure group\n(within matched-Revere European portfolio)")
        ax.set_xlabel("")
        ax.set_ylabel("share of US matched-EU portfolio (%)")
        ax.legend(loc="upper right", frameon=False, title="exposure")
        _date_axis(ax, _span_years(us["report_date"]))

    # BL — US vs non-US for HIGH group + GPR overlay
    ax = axes[1, 0]
    if ts is not None and cmp is not None:
        us_high = ts[(ts["investor_country"] == "US") & (ts["exp_grp"] == "HIGH")]
        if not us_high.empty:
            ax.plot(us_high["report_date"], us_high["within_europe_share"] * 100,
                    label="US", color=COLOR_US, lw=1.8)
        if not cmp.empty and "nonus_within_eu_share" in cmp.columns:
            ax.plot(cmp["report_date"], cmp["nonus_within_eu_share"] * 100,
                    label="non-US", color=COLOR_NONUS, lw=1.8)
        ax.set_title("(B') HIGH-CN-exposure firms: US vs non-US allocation share")
        ax.set_xlabel("")
        ax.set_ylabel("share of matched-EU portfolio (%)")
        ax.legend(loc="upper right", frameon=False)
        _date_axis(ax, _span_years(us_high["report_date"]) if not us_high.empty else 1)

        if cmp is not None and "gpr_us_cn" in cmp.columns:
            ax_gpr = ax.twinx()
            ax_gpr.plot(cmp["report_date"], cmp["gpr_us_cn"],
                        color=COLOR_GPR, lw=1, alpha=0.6, linestyle=":",
                        label="USA|China GPR")
            ax_gpr.set_ylabel("USA|China GPR", color=COLOR_GPR, fontsize=10)
            ax_gpr.tick_params(axis="y", labelcolor=COLOR_GPR)
            ax_gpr.spines["right"].set_visible(True)

    # BR — differential vs GPR scatter
    ax = axes[1, 1]
    if diff is not None and not diff.empty:
        x = diff["gpr_us_cn"]
        y = diff["mean_diff"] * 100
        ax.scatter(x, y, alpha=0.6, s=30, color=PALETTE[3], edgecolors="none")
        if len(x) > 5 and x.std() > 0:
            m, b = np.polyfit(x, y, 1)
            xs = np.linspace(x.min(), x.max(), 100)
            ax.plot(xs, m * xs + b, color="black", lw=1.2, linestyle="--",
                    label=f"slope={m:.3f}")
            corr = np.corrcoef(x, y)[0, 1]
            ax.text(0.04, 0.96, f"corr = {corr:+.3f}", transform=ax.transAxes,
                    va="top", fontsize=10)
            ax.legend(loc="upper right", frameon=False)
        ax.axhline(0, color="gray", lw=0.7, linestyle="-")
        ax.set_title("(C) (Δ US − Δ non-US) holdings vs GPR\nHIGH-CN-exposure firms; descriptive only")
        ax.set_xlabel("USA|China GPR")
        ax.set_ylabel("monthly (Δ US − Δ non-US) holdings (%)")

    fig.suptitle("Pre-regression descriptive checks (Sections 6–7)",
                 fontweight="bold")
    _save(fig, "fig4_pre_regression")


# ============================================================
# FIG 5: Coverage diagnostics (single)
# ============================================================
def fig5_coverage() -> None:
    cas  = _safe_read("05_coverage_cascade.csv")
    comp = _safe_read("05_merged_panel_composition.csv")
    mtype = _safe_read("05_match_type_distribution.csv")

    fig, axes = plt.subplots(1, 3, figsize=(15, 5), constrained_layout=True)

    # Panel A: cascade
    ax = axes[0]
    if cas is not None and not cas.empty:
        row = cas.iloc[0]
        # cas columns: n_eu_sec_total, n_eu_sec_with_<id>, n_eu_sec_matched
        labels, vals = [], []
        for col in cas.columns:
            labels.append(col.replace("n_eu_sec_", "").replace("_", "\n"))
            vals.append(int(row[col]))
        bars = ax.bar(labels, vals, color=[PALETTE[0], PALETTE[1], PALETTE[2], PALETTE[3]][:len(labels)],
                      alpha=0.85, edgecolor="white")
        for bar, v in zip(bars, vals):
            ax.text(bar.get_x() + bar.get_width()/2, v, f"{v:,}",
                    ha="center", va="bottom", fontsize=10)
        ax.set_title("(A) Coverage cascade: EU sec_entity → matched Revere")
        ax.set_ylabel("# sec_entity_ids")

    # Panel B: matched panel composition
    ax = axes[1]
    if comp is not None and not comp.empty:
        comp = comp.copy()
        comp["label"] = comp.apply(
            lambda r: ("US " if r.get("is_us") else "non-US ") +
                      ("with CN" if r.get("has_cn_exposure") else "no CN"),
            axis=1)
        comp = comp.sort_values("n")
        colors = []
        for _, r in comp.iterrows():
            base = COLOR_US if r.get("is_us") else COLOR_NONUS
            colors.append(base if r.get("has_cn_exposure") else "lightgray")
        ax.barh(comp["label"], comp["n"], color=colors, alpha=0.85,
                edgecolor="white")
        ax.set_title("(B) Matched panel composition")
        ax.set_xlabel("# (h, i, t) observations")
        for i, v in enumerate(comp["n"]):
            ax.text(v, i, f" {v:,}", va="center", fontsize=9)

    # Panel C: match type contribution
    ax = axes[2]
    if mtype is not None and not mtype.empty:
        mtype = mtype.sort_values("n_sec_entities", ascending=True)
        ax.barh(mtype["match_type"], mtype["n_sec_entities"],
                color=PALETTE[0], alpha=0.85, edgecolor="white")
        ax.set_title("(C) ID type contribution to matching")
        ax.set_xlabel("# sec_entity_ids matched")
        for i, v in enumerate(mtype["n_sec_entities"]):
            ax.text(v, i, f" {v:,}", va="center", fontsize=9)

    fig.suptitle("Sample-coverage diagnostics", fontweight="bold")
    _save(fig, "fig5_coverage_diagnostics")


# ============================================================
# Dispatch
# ============================================================
FIGURES = {
    "fig1": fig1_china_exposure_overview,
    "fig2": fig2_us_eu_engagement,
    "fig3": fig3_us_ownership_distribution,
    "fig4": fig4_pre_regression,
    "fig5": fig5_coverage,
}


def main():
    if len(sys.argv) > 1:
        names = sys.argv[1:]
    else:
        names = list(FIGURES.keys())
    for name in names:
        fn = FIGURES.get(name)
        if fn is None:
            print(f"unknown figure: {name}; valid: {list(FIGURES.keys())}")
            continue
        print(f"\n[{name}]")
        try:
            fn()
        except Exception as e:
            print(f"  ERROR: {e}")


if __name__ == "__main__":
    main()
